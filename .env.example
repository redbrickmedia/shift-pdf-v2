# BentoPDF Environment Variables
# Copy this file to .env.production and configure as needed.

# CORS Proxy for digital signature certificate chain fetching
VITE_CORS_PROXY_URL=
VITE_CORS_PROXY_SECRET=

# WASM Module URLs
# Leave empty to load the pinned packages from this origin (/wasm/pymupdf/,
# /wasm/gs/, /wasm/cpdf/). Override only for an internal mirror.
VITE_WASM_PYMUPDF_URL=
VITE_WASM_GS_URL=
VITE_WASM_CPDF_URL=

# OCR assets (optional)
# Set all three together for self-hosted or air-gapped OCR.
# Leave empty to use Tesseract.js runtime defaults.
VITE_TESSERACT_WORKER_URL=
VITE_TESSERACT_CORE_URL=
VITE_TESSERACT_LANG_URL=
VITE_TESSERACT_AVAILABLE_LANGUAGES=
VITE_OCR_FONT_BASE_URL=

# Default UI language (build-time)
# Supported: en, ar, be, fr, de, es, zh, zh-TW, vi, tr, id, it, pt, nl, da, ko, sv, ru
VITE_DEFAULT_LANGUAGE=

# Custom branding (build-time)
# Replace the default BentoPDF branding with your own.
# Place your logo file in the public/ folder and set the path relative to it.
# Shift defaults:
#   VITE_BRAND_NAME=Shift PDF
#   VITE_BRAND_LOGO=images/shift-pdf-logo.svg
#   VITE_FOOTER_TEXT=Shift PDF — files stay on your machine
VITE_BRAND_NAME=Shift PDF
VITE_BRAND_LOGO=images/shift-pdf-logo.svg
VITE_FOOTER_TEXT=Shift PDF — files stay on your machine

# Optional ISO timestamp. After this, the home promise card never shows,
# even for first-time visitors. Leave empty to use seven days from first view.
# VITE_PROMISE_BANNER_UNTIL=2026-08-26T00:00:00.000Z

# Optional host API root. Unset by default. Integrated builds inject the host
# analytics object path at deploy time. Do not commit a production origin or
# chrome.shift fallback in source.
# VITE_HOST_API_ROOT=
